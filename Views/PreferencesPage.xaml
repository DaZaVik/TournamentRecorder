<Page
    x:Class="TournamentRecorder.Views.PreferencesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource AppPageBackgroundBrush}">

    <Page.Resources>
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Background" Value="{StaticResource AppCardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="SectionHintTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AppMutedTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="FieldLabelTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="Background" Value="{StaticResource AppCardSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AppAccentBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AppAccentForegroundBrush}" />
        </Style>
    </Page.Resources>

    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Верх -->
        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="24">
            <StackPanel Spacing="6">
                <TextBlock
                    Text="Настройки"
                    FontSize="30"
                    FontWeight="SemiBold" />

                <TextBlock
                    Text="Внешний вид, запись и параметры окна."
                    Style="{StaticResource SectionHintTextStyle}" />
            </StackPanel>
        </Border>

        <!-- Контент -->
        <ScrollViewer
            Grid.Row="1"
            Margin="0,16,0,16"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">

            <StackPanel Spacing="16">

                <!-- Внешний вид -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock
                            Text="Тема интерфейса"
                            Style="{StaticResource SectionTitleTextStyle}" />

                        <TextBlock
                            Text="Основная, чёрная или светлая тема."
                            Style="{StaticResource SectionHintTextStyle}" />

                        <ComboBox
                            x:Name="ThemeComboBox"
                            Header="Выбор темы">
                            <ComboBoxItem Content="Основная" Tag="Primary" />
                            <ComboBoxItem Content="Чёрная" Tag="Black" />
                            <ComboBoxItem Content="Светлая" Tag="Light" />
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- Запись -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <Grid ColumnSpacing="18" RowSpacing="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Grid.ColumnSpan="2"
                            Text="Параметры записи"
                            Style="{StaticResource SectionTitleTextStyle}" />

                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Text="Папка записей"
                            Style="{StaticResource FieldLabelTextStyle}" />

                        <TextBox
                            x:Name="RootFolderTextBox"
                            Grid.Row="1"
                            Grid.Column="1"
                            PlaceholderText="Например: турнир_записи" />

                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            Text="Название турнира по умолчанию"
                            Style="{StaticResource FieldLabelTextStyle}" />

                        <TextBox
                            x:Name="TournamentNameTextBox"
                            Grid.Row="2"
                            Grid.Column="1"
                            PlaceholderText="Например: турнир" />

                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="0"
                            Text="Длина сегмента (мин)"
                            Style="{StaticResource FieldLabelTextStyle}" />

                        <NumberBox
                            x:Name="SegmentDurationNumberBox"
                            Grid.Row="3"
                            Grid.Column="1"
                            Minimum="1"
                            Maximum="60"
                            SmallChange="1"
                            SpinButtonPlacementMode="Compact" />
                    </Grid>
                </Border>

                <!-- Окно -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <Grid ColumnSpacing="18" RowSpacing="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Text="Параметры окна"
            Style="{StaticResource SectionTitleTextStyle}" />

                        <CheckBox
            x:Name="UseFixedWindowSizeCheckBox"
            Grid.Row="1"
            Grid.ColumnSpan="2"
            Content="Фиксированный размер окна" />

                        <CheckBox
            x:Name="UseAutoWindowSizingCheckBox"
            Grid.Row="2"
            Grid.ColumnSpan="2"
            Content="Автоматически подбирать размер окна под экран Windows" />

                        <TextBlock
            Grid.Row="3"
            Grid.Column="0"
            Text="Размер окна"
            Style="{StaticResource FieldLabelTextStyle}" />

                        <StackPanel
            Grid.Row="3"
            Grid.Column="1"
            Orientation="Horizontal"
            Spacing="12">

                            <NumberBox
                x:Name="WindowWidthNumberBox"
                Header="Ширина"
                Minimum="800"
                Maximum="4000"
                SmallChange="10"
                Width="180"
                SpinButtonPlacementMode="Compact" />

                            <NumberBox
                x:Name="WindowHeightNumberBox"
                Header="Высота"
                Minimum="600"
                Maximum="3000"
                SmallChange="10"
                Width="180"
                SpinButtonPlacementMode="Compact" />
                        </StackPanel>

                        <TextBlock
            Grid.Row="4"
            Grid.Column="0"
            Text="Масштаб интерфейса (%)"
            Style="{StaticResource FieldLabelTextStyle}" />

                        <NumberBox
    x:Name="UiScalePercentNumberBox"
    Grid.Row="4"
    Grid.Column="1"
    Minimum="85"
    Maximum="110"
    SmallChange="5"
    SpinButtonPlacementMode="Compact" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Низ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" />

            <Button
                Grid.Column="1"
                Content="Назад"
                Style="{StaticResource SecondaryButtonStyle}"
                Margin="0,0,10,0"
                Click="BackButton_Click" />

            <Button
                Grid.Column="2"
                Content="Сохранить"
                Style="{StaticResource PrimaryButtonStyle}"
                Click="SaveButton_Click" />
        </Grid>
    </Grid>
</Page>