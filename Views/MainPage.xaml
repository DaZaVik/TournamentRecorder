<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TournamentRecorder.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:TournamentRecorder.Models"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <Style x:Key="ModernActionButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{StaticResource AppCardSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
        </Style>

        <Style x:Key="PrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernActionButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AppAccentBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AppAccentForegroundBrush}" />
        </Style>

        <Style x:Key="PinnedTopButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernActionButtonStyle}">
            <Setter Property="MinWidth" Value="110" />
        </Style>
    </Page.Resources>

    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Border
            Grid.Row="0"
            Padding="22"
            CornerRadius="24"
            Background="{StaticResource AppCardBrush}"
            BorderBrush="{StaticResource AppBorderBrush}"
            BorderThickness="1">

            <Grid RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Верхняя строка: заголовок + всегда доступные кнопки -->
                <Grid Grid.Row="0" ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="6">
                        <TextBlock
                            Text="Рабочее окно турнира"
                            FontSize="30"
                            FontWeight="SemiBold" />

                        <TextBlock
                            x:Name="SessionInfoTextBlock"
                            Text="Сессия не инициализирована"
                            Foreground="{StaticResource AppMutedTextBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Top">
                        <Button
                            Style="{StaticResource PinnedTopButtonStyle}"
                            Content="Настройки"
                            Click="SettingsButton_Click" />

                        <Button
                            Style="{StaticResource PinnedTopButtonStyle}"
                            Content="Назад"
                            Click="BackButton_Click" />
                    </StackPanel>
                </Grid>

                <!-- Нижняя строка: прокручиваемые массовые действия -->
                <ScrollViewer
                    Grid.Row="1"
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Enabled"
                    VerticalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Disabled"
                    ZoomMode="Disabled">

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button
                            x:Name="CheckCamerasButton"
                            Style="{StaticResource ModernActionButtonStyle}"
                            Content="Проверка камер"
                            Click="CheckCamerasButton_Click" />

                        <Button
                            x:Name="RecoverProblematicButton"
                            Style="{StaticResource ModernActionButtonStyle}"
                            Content="Восстановить проблемные"
                            Click="RecoverProblematicButton_Click"
                            IsEnabled="False" />

                        <Button
                            x:Name="RecordAllButton"
                            Style="{StaticResource PrimaryActionButtonStyle}"
                            Content="Запись всех"
                            Click="RecordAllButton_Click" />

                        <Button
                            x:Name="SaveAllButton"
                            Style="{StaticResource ModernActionButtonStyle}"
                            Content="Сохранить все"
                            Click="SaveAllButton_Click" />

                        <Button
                            x:Name="StopAllButton"
                            Style="{StaticResource ModernActionButtonStyle}"
                            Content="Стоп всех"
                            Click="StopAllButton_Click" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Плашка системы -->
        <Border
            x:Name="SystemStateBanner"
            Grid.Row="1"
            Margin="0,16,0,0"
            Padding="18"
            CornerRadius="20"
            Background="{StaticResource AppBannerBrush}"
            BorderBrush="{StaticResource AppBorderBrush}"
            BorderThickness="1"
            Visibility="Collapsed">

            <Grid ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="8">
                    <TextBlock
                        x:Name="SystemStateTitleTextBlock"
                        Text="Состояние системы"
                        FontSize="18"
                        FontWeight="SemiBold" />

                    <StackPanel Orientation="Horizontal" Spacing="20">
                        <TextBlock
                            x:Name="ProblematicCountTextBlock"
                            Text="Проблемных камер: 0" />

                        <TextBlock
                            x:Name="RecoveringCountTextBlock"
                            Text="Восстанавливаются: 0" />

                        <TextBlock
                            x:Name="RecordingCountTextBlock"
                            Text="Идёт запись: 0" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Карточки камер -->
        <ScrollViewer
            Grid.Row="2"
            Margin="0,16,0,0"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollMode="Auto"
            HorizontalScrollMode="Disabled">

            <ItemsControl
                x:Name="CameraSlotsItemsControl"
                ItemsSource="{x:Bind CameraSlots, Mode=OneWay}">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid
                            Orientation="Horizontal"
                            MaximumRowsOrColumns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:CameraSlotModel">
                        <Border
                            Margin="0,0,18,18"
                            Padding="18"
                            MinWidth="470"
                            MaxWidth="640"
                            CornerRadius="24"
                            Background="{StaticResource AppCardBrush}"
                            BorderBrush="{StaticResource AppBorderBrush}"
                            BorderThickness="1">

                            <Grid RowSpacing="14">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Заголовок -->
                                <Grid Grid.Row="0" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="0"
                                        Text="{x:Bind DisplayTitle}"
                                        FontSize="23"
                                        FontWeight="SemiBold" />

                                    <Border
                                        Grid.Column="1"
                                        Padding="10,4"
                                        CornerRadius="999"
                                        Background="{StaticResource AppStatusChipBrush}">

                                        <TextBlock
                                            Text="{x:Bind SegmentTimerText, Mode=OneWay}"
                                            FontWeight="SemiBold"
                                            VerticalAlignment="Center" />
                                    </Border>
                                </Grid>

                                <!-- Поля -->
                                <Grid
                                    Grid.Row="1"
                                    ColumnSpacing="14"
                                    RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Text="Физическая камера"
                                        Foreground="{StaticResource AppMutedTextBrush}" />

                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Text="Комментарий"
                                        Foreground="{StaticResource AppMutedTextBrush}" />

                                    <ComboBox
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        PlaceholderText="Выберите камеру"
                                        ItemsSource="{x:Bind AvailableCameras}"
                                        SelectedItem="{x:Bind SelectedCamera, Mode=TwoWay}"
                                        DisplayMemberPath="DisplayName"
                                        SelectionChanged="CameraSelectionChanged"
                                        Tag="{x:Bind SlotNumber}" />

                                    <TextBox
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        PlaceholderText="Например: ковер_1"
                                        Text="{x:Bind Comment, Mode=TwoWay}" />
                                </Grid>

                                <!-- Превью -->
                                <Border
                                    Grid.Row="2"
                                    MinHeight="250"
                                    CornerRadius="18"
                                    Background="{StaticResource AppPanelBrush}"
                                    BorderBrush="{StaticResource AppBorderBrush}"
                                    BorderThickness="1">

                                    <Grid>
                                        <MediaPlayerElement
                                            Tag="{x:Bind SlotNumber}"
                                            AreTransportControlsEnabled="False"
                                            AutoPlay="False"
                                            Loaded="PreviewElement_Loaded"
                                            Unloaded="PreviewElement_Unloaded" />

                                        <StackPanel
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Spacing="8"
                                            IsHitTestVisible="False">

                                            <TextBlock
                                                Text="◉"
                                                FontSize="28"
                                                Foreground="{StaticResource AppAccentSecondaryBrush}"
                                                Opacity="0.50"
                                                HorizontalAlignment="Center" />

                                            <TextBlock
                                                Text="Зона превью камеры"
                                                Foreground="{StaticResource AppMutedTextBrush}"
                                                HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Статус -->
                                <Border
                                    Grid.Row="3"
                                    Padding="12"
                                    CornerRadius="16"
                                    Background="{StaticResource AppCardSecondaryBrush}"
                                    BorderBrush="{StaticResource AppBorderBrush}"
                                    BorderThickness="1">

                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            Grid.Column="0"
                                            Text="Статус:"
                                            FontWeight="SemiBold"
                                            VerticalAlignment="Center" />

                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{x:Bind Status, Mode=OneWay}"
                                            TextWrapping="Wrap"
                                            VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <!-- Кнопки -->
                                <Grid Grid.Row="4" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" />

                                    <Button
                                        Grid.Column="1"
                                        Style="{StaticResource PrimaryActionButtonStyle}"
                                        Content="Запись"
                                        Tag="{x:Bind SlotNumber}"
                                        IsEnabled="{x:Bind CanRecord, Mode=OneWay}"
                                        Click="RecordButton_Click" />

                                    <Button
                                        Grid.Column="2"
                                        Style="{StaticResource ModernActionButtonStyle}"
                                        Content="Сохранить"
                                        Tag="{x:Bind SlotNumber}"
                                        IsEnabled="{x:Bind CanSave, Mode=OneWay}"
                                        Click="SaveButton_Click" />

                                    <Button
                                        Grid.Column="3"
                                        Style="{StaticResource ModernActionButtonStyle}"
                                        Content="Стоп"
                                        Tag="{x:Bind SlotNumber}"
                                        IsEnabled="{x:Bind CanStop, Mode=OneWay}"
                                        Click="StopButton_Click" />

                                    <Button
                                        Grid.Column="4"
                                        Style="{StaticResource ModernActionButtonStyle}"
                                        Content="Восстановить"
                                        Tag="{x:Bind SlotNumber}"
                                        IsEnabled="{x:Bind CanRecover, Mode=OneWay}"
                                        Click="RecoverButton_Click" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>